{
  "name": "@vucinatim/agentic-devtools",
  "version": "0.3.1",
  "private": false,
  "description": "MCP-first devtools for AI agents.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Tim Vucina",
    "email": "tim@vucina.com",
    "url": "https://github.com/vucinatim"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vucinatim/agentic-devtools.git"
  },
  "homepage": "https://github.com/vucinatim/agentic-devtools#readme",
  "bugs": {
    "url": "https://github.com/vucinatim/agentic-devtools/issues"
  },
  "keywords": [
    "agentic-devtools",
    "mcp",
    "mcp-server",
    "agents",
    "ai-agents",
    "cloudflare",
    "namecheap",
    "railway",
    "npm",
    "developer-tools"
  ],
  "bin": {
    "agentic-devtools": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./cloudflare": "./src/tools/cloudflare/client.mjs",
    "./namecheap": "./src/tools/namecheap/client.mjs",
    "./railway": "./src/tools/railway/client.mjs",
    "./npm": "./src/tools/npm/client.mjs",
    "./axiom": "./src/tools/axiom/client.mjs"
  },
  "files": [
    "src",
    "adapters",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/check-syntax.mjs",
    "check": "npm run build && npm run coverage && npm run audit && npm run validate:package && npm run smoke:local && npm run prepublish:check",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "pack:dry": "npm pack --dry-run",
    "test": "vitest run",
    "test:published": "node scripts/test-published-package.mjs",
    "test:watch": "vitest",
    "test:cloudflare": "vitest run tests/tools/cloudflare",
    "test:namecheap": "vitest run tests/tools/namecheap",
    "test:railway": "vitest run tests/tools/railway",
    "test:axiom": "vitest run tests/tools/axiom",
    "validate:package": "node scripts/validate-package.mjs",
    "smoke:local": "node scripts/local-artifact-smoke.mjs",
    "smoke:cloudflare": "node scripts/smoke/cloudflare.mjs",
    "smoke:railway": "node scripts/smoke/railway.mjs",
    "smoke:axiom": "node scripts/smoke/axiom.mjs",
    "smoke:npm": "node scripts/smoke/npm.mjs",
    "smoke:namecheap": "node scripts/smoke/namecheap.mjs",
    "prepublish:check": "node scripts/pre-publish-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "fast-xml-parser": "^5.8.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "vitest": "^4.1.6"
  }
}
